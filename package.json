{
  "name": "iframely-wordpress",
  "version": "1.2.0",
  "description": "Iframely WordPress plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowby/iframely-wordpress.git"
  },
  "keywords": [
    "gutenberg",
    "embed",
    "iframely"
  ],
  "author": "Iframely.com",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/yellowby/iframely-wordpress/issues"
  },
  "homepage": "https://github.com/yellowby/iframely-wordpress#readme",
  "prettier": {
    "singleQuote": true,
    "useTabs": false,
    "tabWidth": 2,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "source": "src/index.js",
  "main": "js/index.js",
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "env:start": "wp-env start && wp-env --config=.wp-env.tests.json start",
    "env:start:dev": "wp-env start",
    "env:start:tests": "wp-env --config=.wp-env.tests.json start",
    "env:stop": "wp-env stop && wp-env --config=.wp-env.tests.json stop",
    "env:reset": "wp-env reset && wp-env --config=.wp-env.tests.json reset",
    "env:destroy": "wp-env destroy && wp-env --config=.wp-env.tests.json destroy",
    "env:logs": "wp-env logs",
    "wp": "wp-env run cli wp",
    "wp:tests": "wp-env --config=.wp-env.tests.json run cli wp",
    "composer": "wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/iframely composer",
    "test": "npm run test:js && npm run test:php && npm run test:php:multisite && npm run test:e2e",
    "test:js": "wp-scripts test-unit-js",
    "test:php": "wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/iframely vendor/bin/phpunit",
    "test:php:multisite": "wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/iframely env WP_MULTISITE=1 vendor/bin/phpunit",
    "test:php:live": "node tests/bin/phpunit-live.js",
    "test:matrix": "node tests/bin/matrix.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php && npm run lint:phpstan",
    "lint:js": "wp-scripts lint-js src tests tools",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'",
    "lint:php": "wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/iframely vendor/bin/phpcs",
    "lint:php:fix": "wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/iframely vendor/bin/phpcbf",
    "lint:phpstan": "wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/iframely vendor/bin/phpstan analyse --memory-limit=1G",
    "lint:plugin-check": "node tools/plugin-check.js",
    "format": "prettier --write src tests/js tests/e2e tests/bin tools",
    "release": "node tools/release.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@wordpress/e2e-test-utils-playwright": "^3.2.0",
    "@wordpress/env": "^12.1.0",
    "@wordpress/scripts": "^37.1.0",
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/compose": "^9.1.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/hooks": "^5.1.0",
    "@wordpress/i18n": "^7.1.0"
  }
}
